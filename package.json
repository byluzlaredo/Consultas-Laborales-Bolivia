{
  "name": "consulta-laboral-bolivia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm run dev:server\" \"vite\"",
    "dev:serve": "vite",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "build": "tsc && vite build",
    "test": "tsx --test \"server/Pruebas/**/*.test.ts\"",
    "test:unitarias": "tsx --test \"server/Pruebas/Unitarias/*.test.ts\"",
    "test:integracion": "tsx --test \"server/Pruebas/Integracion/*.test.ts\"",
    "test:transicion": "tsx --test \"server/Pruebas/Transicion de estado/*.test.ts\"",
    "test:compatibilidad": "tsx --test \"server/Pruebas/Compatibilidad/*.test.ts\"",
    "test:usabilidad": "tsx --test \"server/Pruebas/Usabilidad/*.test.ts\"",
    "test:caja-blanca": "tsx --test \"server/Pruebas/CajaBlanca/*.test.ts\"",
    "test:seguridad": "tsx --test \"server/Pruebas/Seguridad/**/*.test.ts\"",
    "test:pipeline": "tsx --env-file=.env server/scripts/testPipeline.ts",
    "import:pdfs": "tsx --env-file=.env server/scripts/importAllPdfs.ts",
    "vectorize:pdfs": "tsx --env-file=.env server/scripts/vectorizeAllDocuments.ts",
    "preview": "vite preview",
    "start:server": "node --loader ts-node/esm server/index.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.5",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.24",
    "@types/pdf-parse": "^1.1.1",
    "@types/pg": "^8.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
